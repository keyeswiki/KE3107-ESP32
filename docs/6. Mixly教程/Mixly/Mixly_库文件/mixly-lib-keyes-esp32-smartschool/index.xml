<script defer src="main.bundle.js"></script>
<category id="smart_school" name="ESP32 智慧校园" colour="200">

  <!-- ======== LED ======== -->
  <category id="smart_school_led" name="LED 灯" colour="200">
    <block type="LED_setLEDState">
      <value name="pin">
        <shadow type="pins_digital"></shadow>
      </value>
    </block>
    <block type="led_analog">
      <value name="PIN">
        <shadow type="pins_digital"></shadow>
      </value>
      <value name="VAL">
        <shadow type="math_number">
          <field name="NUM">128</field>
        </shadow>
      </value>
    </block>
  </category>

  <!-- ======== RGB 灯带 ======== -->
  <category id="smart_school_rgb" name="RGB 灯带" colour="200">
    <block type="bbrgbLedStrip_init">
      <value name="PIN">
        <shadow type="pins_digital"></shadow>
      </value>
      <value name="LEN">
        <shadow type="math_number">
          <field name="NUM">4</field>
        </shadow>
      </value>
    </block>
    <block type="rgbLedStrip_setPixelColor">
      <value name="NO">
        <shadow type="math_number">
          <field name="NUM">0</field>
        </shadow>
      </value>
      <value name="COLOR">
        <shadow type="math_number">
          <field name="NUM">0</field>
        </shadow>
      </value>
    </block>
    <block type="rgbLedStrip_fill">
      <value name="FIRST">
        <shadow type="math_number">
          <field name="NUM">0</field>
        </shadow>
      </value>
      <value name="COUNT">
        <shadow type="math_number">
          <field name="NUM">3</field>
        </shadow>
      </value>
      <value name="COLOR">
        <shadow type="math_number">
          <field name="NUM">0</field>
        </shadow>
      </value>
    </block>
    <block type="rgbLedStrip_color">
      <value name="R">
        <shadow type="math_number">
          <field name="NUM">255</field>
        </shadow>
      </value>
      <value name="G">
        <shadow type="math_number">
          <field name="NUM">0</field>
        </shadow>
      </value>
      <value name="B">
        <shadow type="math_number">
          <field name="NUM">0</field>
        </shadow>
      </value>
    </block>
    <block type="rgbLedStrip_setBrightness">
      <value name="BRT">
        <shadow type="math_number">
          <field name="NUM">255</field>
        </shadow>
      </value>
    </block>
    <block type="rgbLedStrip_clear"></block>
    <block type="rgbLedStrip_show"></block>
  </category>

  <!-- ======== 蜂鸣器 ======== -->
  <category id="smart_school_buzzer" name="蜂鸣器" colour="200">
    <block type="buzzer_tone_d">
      <value name="PIN">
        <shadow type="pins_digital"></shadow>
      </value>
      <value name="dur">
        <shadow type="math_number">
          <field name="NUM">131</field>
        </shadow>
      </value>
    </block>
    <block type="buzzer_music">
      <value name="PIN">
        <shadow type="pins_digital"></shadow>
      </value>
    </block>
    <block type="buzzer_notone">
      <value name="PIN">
        <shadow type="pins_digital"></shadow>
      </value>
    </block>
  </category>

  <!-- ======== 传感器 ======== -->
  <category id="smart_school_sensor" name="传感器" colour="200">
    <block type="Button_readState">
      <value name="pin">
        <shadow type="pins_digital"></shadow>
      </value>
    </block>
    <block type="Button_readValue">
      <value name="pin">
        <shadow type="pins_digital"></shadow>
      </value>
    </block>
    <block type="pir_readValue">
      <value name="pin">
        <shadow type="pins_digital"></shadow>
      </value>
    </block>
    <block type="infrared_readValue">
      <value name="pin">
        <shadow type="pins_digital"></shadow>
      </value>
    </block>
    <block type="lightSensor_readValue">
      <value name="pin">
        <shadow type="pins_analog"></shadow>
      </value>
    </block>
    <block type="aht20_read"></block>
    <block type="ens160_read"></block>
  </category>

  <!-- ======== 舵机 & 电机 ======== -->
  <category id="smart_school_motor" name="舵机 &amp; 电机" colour="200">
    <block type="ks_servo_angle">
      <value name="pin">
        <shadow type="pins_digital"></shadow>
      </value>
      <value name="angle">
        <shadow type="math_number">
          <field name="NUM">90</field>
        </shadow>
      </value>
      <value name="time">
        <shadow type="math_number">
          <field name="NUM">200</field>
        </shadow>
      </value>
    </block>
    <block type="motor130">
      <value name="IN1">
        <shadow type="pins_digital"></shadow>
      </value>
      <value name="IN2">
        <shadow type="pins_digital"></shadow>
      </value>
      <value name="SPEED2">
        <shadow type="math_number">
          <field name="NUM">255</field>
        </shadow>
      </value>
    </block>
  </category>

  <!-- ======== 步进电机 ======== -->
  <category id="smart_school_stepper" name="步进电机" colour="200">
    <block type="stepper_init">
      <value name="IN1">
        <shadow type="math_number">
          <field name="NUM">8</field>
        </shadow>
      </value>
      <value name="IN2">
        <shadow type="math_number">
          <field name="NUM">9</field>
        </shadow>
      </value>
      <value name="IN3">
        <shadow type="math_number">
          <field name="NUM">10</field>
        </shadow>
      </value>
      <value name="IN4">
        <shadow type="math_number">
          <field name="NUM">11</field>
        </shadow>
      </value>
      <value name="steps">
        <shadow type="math_number">
          <field name="NUM">2048</field>
        </shadow>
      </value>
      <value name="speed">
        <shadow type="math_number">
          <field name="NUM">10</field>
        </shadow>
      </value>
    </block>
    <block type="stepper_step">
      <value name="stepsNum">
        <shadow type="math_number">
          <field name="NUM">512</field>
        </shadow>
      </value>
    </block>
  </category>

  <!-- ======== RFID ======== -->
  <category id="smart_school_rfid" name="RFID" colour="200">
    <block type="rc522_init"></block>
    <block type="rc522_read"></block>
  </category>

  <!-- ======== OLED 屏幕 ======== -->
  <category id="smart_school_oled" name="OLED 屏幕" colour="200">
    <block type="oled_init"></block>
    <block type="oled_setText"></block>
    <block type="oled_setCursor">
      <value name="X">
        <shadow type="math_number">
          <field name="NUM">0</field>
        </shadow>
      </value>
      <value name="Y">
        <shadow type="math_number">
          <field name="NUM">0</field>
        </shadow>
      </value>
    </block>
    <block type="oled_print">
      <value name="DATA">
        <shadow type="text">
          <field name="TEXT">Hello Mixly</field>
        </shadow>
      </value>
    </block>
    <block type="oled_image"></block>
    <block type="oled_clear"></block>
    <block type="oled_refresh"></block>
  </category>

  <!-- ======== WiFi ======== -->
  <category id="smart_school_wifi" name="WiFi" colour="200">
    <block type="wifi_init">
      <value name="SSID">
        <shadow type="text">
          <field name="TEXT">ChinaNet_2.4G</field>
        </shadow>
      </value>
      <value name="PASSWD">
        <shadow type="text">
          <field name="TEXT">ChinaNet@233</field>
        </shadow>
      </value>
    </block>
    <block type="wifi_read_ip"></block>
    <block type="wifi_client_init"></block>
    <block type="wifi_client_connected"></block>
    <block type="wifi_send_data"></block>
    <block type="wifi_read_data"></block>
  </category>

</category>
